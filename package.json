{
  "name": "universal-claimer-session-exporter",
  "version": "0.2.1",
  "private": true,
  "description": "Export your logged-in session cookies locally, to connect an account in your self-hosted Universal Claimer.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "lint": "node scripts/check-manifest.mjs && web-ext lint --source-dir=src",
    "build": "web-ext build --source-dir=src --artifacts-dir=dist --overwrite-dest",
    "check-version": "node scripts/check-version.mjs"
  },
  "devDependencies": {
    "vitest": "^4.1.11",
    "web-ext": "^8.3.0",
    "chrome-webstore-upload-cli": "^3.3.0"
  }
}
